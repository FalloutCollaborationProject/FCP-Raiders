<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Unique Character Base __________-->

    <PawnKindDef Name="FCP_Raiders_UniqueCharacterBase" ParentName="FCP_RaiderBase" Abstract="True">
        <showInDebugSpawner>false</showInDebugSpawner>
        <apparelMoney>9999</apparelMoney>
        <gearHealthRange>0.6~1.0</gearHealthRange>
        <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
        <weaponMoney>9999</weaponMoney>
        <initialWillRange>10~30</initialWillRange>
        <initialResistanceRange>10~30</initialResistanceRange>
        <apparelTags>
            <li>FCP_Raider_Armor</li>
            <li MayRequire="Rick.FCP.Wastelanders">FCP_Wastelander_Apparel</li>
        </apparelTags>
        <apparelDisallowTags>
            <li>FCP_BoS_Apparel</li>
            <li>FCP_NCR_Apparel</li>
            <li>FCP_Legion_Apparel</li>
            <li>FCP_Enclave_Apparel</li>
            <li>FCP_USA_Apparel</li>
            <li>FCP_Minutemen_Combat_Armor_Modular</li>
            <li>FCP_Weapon_USA_Alloy_Steel_Assault_Rifle</li>
            <li>FCP_Great_Khan_Armor</li>
            <li>FCP_Great_Khan_Helmet</li>
        </apparelDisallowTags>
    </PawnKindDef>

    <!--__________ Fiends __________-->

    <!-- Motor-Runner -->
    <PawnKindDef ParentName="FCP_Raiders_UniqueCharacterBase">
        <defName>FCP_Unique_Pawnkind_Fiend_MotorRunner</defName>
        <label>Motor-Runner</label>
        <factionLeader>true</factionLeader>
        <combatPower>150</combatPower>
        <canBeSapper>true</canBeSapper>
        <apparelRequired>
            <li>FCP_Apparel_Fiend_Battle_Helmet</li>
        </apparelRequired>
        <weaponTags>
            <li>FCP_Light_Machine_Gun</li>
        </weaponTags>
        <forcedTraits>
            <li>
                <def>Psychopath</def>
            </li>
        </forcedTraits>
        <backstoryFiltersOverride>
            <li>
                <categoriesAdulthood>
                    <li>FCP_Backstory_Fiends</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

