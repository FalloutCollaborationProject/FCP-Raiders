<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Fiends __________-->

    <FactionDef ParentName="FactionBase">
        <defName>FCP_Faction_Fiends</defName>
        <label>the Fiends</label>
        <description>The Fiends never had a plan beyond the next hit. What passes for their turf is a vault that got cracked open long before they found it, and they've filled it with enough chems to keep a small army high, paranoid, and trigger-happy at the same time. There's no chain of command to speak of, just whoever's meanest when the drugs run out.</description>
        <colorSpectrum>
            <li>(0.55, 0.15, 0.55)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
        <pawnSingular>Fiend</pawnSingular>
        <pawnsPlural>Fiends</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.12</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxCountAtGameStart>1</maxCountAtGameStart>
        <naturalEnemy>true</naturalEnemy>
        <permanentEnemy>true</permanentEnemy>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Overlord</leaderTitle>
        <factionIconPath>World_Icon/Raider_Icon/FCP_Raider_World_Icon</factionIconPath>
        <techLevel>Industrial</techLevel>
        <fixedName>The Fiends</fixedName>
        <settlementNameMaker>FCP_Namer_Settlement_Raiders</settlementNameMaker>
        <allowedCultures>
            <li>FCP_Culture_Raider</li>
        </allowedCultures>
        <fixedLeaderKinds>
            <li>FCP_Unique_Pawnkind_Fiend_MotorRunner</li>
        </fixedLeaderKinds>

        <!--__________ Ideology __________-->

        <fixedIdeo>true</fixedIdeo>
        <ideoName>The Next Hit</ideoName>
        <ideoDescription>The Fiends don't have beliefs so much as appetites. Whatever gets them higher, hits harder, or lasts longer between doses is good; everything else, including each other, is expendable the moment it stops being useful.</ideoDescription>
        <styles>
            <li>FCP_Style_Raider</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Morbid</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

        <!--__________ Biotech __________-->

        <xenotypeSet>
            <xenotypeChances>
                <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
                <Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
                <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
                <Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
                <Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
                <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
                <Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
            </xenotypeChances>
        </xenotypeSet>

        <!--__________ Backstories __________-->

        <backstoryFilters>
            <li>
                <categories>
                    <li>FCP_Backstory_Fiends</li>
                    <li>FCP_Backstory_Raiders_Child</li>
                </categories>
                <commonality>1</commonality>
            </li>
        </backstoryFilters>

        <!--__________ Kinds __________-->

        <caravanTraderKinds>
        </caravanTraderKinds>

        <visitorTraderKinds>
        </visitorTraderKinds>

        <baseTraderKinds>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
        <raidLootMaker>FCP_RaiderRaidLootMaker</raidLootMaker>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,80)</li>
                <li>(70, 100)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <!--__________ Group Makers __________-->

        <pawnGroupMakers>

            <li Class="FCP.Core.GroupMakerWithCustomChar">
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <FCP_Fiend_Junkie>12</FCP_Fiend_Junkie>
                    <FCP_Fiend_Gunner>9</FCP_Fiend_Gunner>
                    <FCP_Fiend_Berserker>7</FCP_Fiend_Berserker>
                    <FCP_Fiend_Slasher>6</FCP_Fiend_Slasher>
                    <FCP_Fiend_Overlord>2</FCP_Fiend_Overlord>
                </options>
                <characterDefs>
                    <li>FCP_Character_Fiend_CookCook</li>
                    <li>FCP_Character_Fiend_DriverNephi</li>
                    <li>FCP_Character_Fiend_Violet</li>
                </characterDefs>
                <characterChance>0.15</characterChance>
            </li>

            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <FCP_Unique_Pawnkind_Fiend_MotorRunner>1</FCP_Unique_Pawnkind_Fiend_MotorRunner>
                    <FCP_Fiend_Overlord>3</FCP_Fiend_Overlord>
                    <FCP_Fiend_Junkie>7</FCP_Fiend_Junkie>
                </options>
            </li>

            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <FCP_Fiend_Overlord>2</FCP_Fiend_Overlord>
                    <FCP_Fiend_Berserker>6</FCP_Fiend_Berserker>
                    <FCP_Fiend_Gunner>7</FCP_Fiend_Gunner>
                    <FCP_Fiend_Junkie>8</FCP_Fiend_Junkie>
                    <FCP_Fiend_Slasher>6</FCP_Fiend_Slasher>
                </options>
            </li>

        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
        <modExtensions Inherit="False">
            <li Class="FCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>The Fiends</newLabel>
            </li>
            <li Class="FCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="FCP.Factions.FactionExtension_FixedIdeo">
                <ideoIconDef>Skull</ideoIconDef>
                <ideoColorDef>DarkPurple</ideoColorDef>
                <memberName>Fiend</memberName>
                <adjective>Fiend</adjective>
                <roleOverrides>
                    <li>
                        <preceptDef>IdeoRole_Leader</preceptDef>
                        <newName>Overlord</newName>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_Moralist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_ShootingSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_MeleeSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_ResearchSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_PlantSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_ProductionSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_MiningSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_AnimalsSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_MedicalSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                </roleOverrides>
            </li>
            <li Class="FCP.Factions.FactionExtension_HasTerritory">
                <territoryColor>(0.55, 0.15, 0.55, 1.0)</territoryColor>
                <territoryBorderColor>(0.28, 0.06, 0.28, 1.0)</territoryBorderColor>
                <factionLabelColor>(0.85, 0.55, 0.9, 1.0)</factionLabelColor>
                <initialTerritoryRadius>5</initialTerritoryRadius>
                <renderTerritoryOverWater>false</renderTerritoryOverWater>
            </li>
            <li Class="FCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li>FCP_Faction_Forged</li>
                    <li>FCP_Faction_Cannibals</li>
                </hostileFactionDefs>
            </li>
            <li Class="FCP.Factions.FactionExtension_SettlementControl">
                <maxSettlements>1</maxSettlements>
                <searchRadius>500</searchRadius>
                <allowedBiomes>
                    <li>AridShrubland</li>
                </allowedBiomes>
                <namedSettlements>
                    <li>
                        <name>Vault 3</name>
                        <preferredHilliness>
                            <li>SmallHills</li>
                            <li>Flat</li>
                        </preferredHilliness>
                        <allowedBiomes>
                            <li>AridShrubland</li>
                        </allowedBiomes>
                    </li>
                </namedSettlements>
            </li>
            <!-- Enlistment stuff -->
            <li Class="FCP.Enlist.FactionEnlistOptions">
                <enlistOptionsDefs>
                    <li>FCP_Enlistment_Raiders</li>
                </enlistOptionsDefs>
                <ignoreAutoAssignedDefs>true</ignoreAutoAssignedDefs>
            </li>
        </modExtensions>
    </FactionDef>

</Defs>
