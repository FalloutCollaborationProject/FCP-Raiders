<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Factions __________-->

    <!-- Jackals -->

    <FactionDef ParentName="FactionBase">
        <defName>FCP_Faction_Jackals</defName>
        <label>Jackals</label>
        <description>The Jackals are the most common raider gang in the wasteland: a loose, ever-shifting pack of scavengers and thugs who never hold a settlement for long before moving on to the next one. What they lack in discipline or organization, they make up for in sheer numbers, jumping anything that looks weaker than they are and running from anything that doesn't. Other gangs look down on them as low-rent opportunists, but the Jackals outlast most of them anyway.</description>
        <royalTitleTags>
            <li>FCP_Title_Raider</li>
        </royalTitleTags>
        <royalFavorLabel>Trophies</royalFavorLabel>
        <royalTitleInheritanceWorkerClass>RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
        <royalTitleInheritanceRelations>
        </royalTitleInheritanceRelations>
        <colorSpectrum>
            <li>(1, 1, 1)</li>
        </colorSpectrum>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Jackal</pawnSingular>
        <pawnsPlural>Jackals</pawnsPlural>
        <categoryTag>Outlander</categoryTag>
        <settlementGenerationWeight>0.4</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <permanentEnemy>true</permanentEnemy>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Pack Leader</leaderTitle>
        <factionIconPath>World_Icon/Raider_Icon/FCP_Raider_World_Icon</factionIconPath>
        <techLevel>Industrial</techLevel>
        <fixedName>The Jackals</fixedName>
        <settlementNameMaker>FCP_Namer_Settlement_Raiders</settlementNameMaker>
        <allowedCultures>
            <li>FCP_Culture_Raider</li>
        </allowedCultures>
        <fixedLeaderKinds>
            <li>FCP_Unique_Pawnkind_Jackal_Mange</li>
        </fixedLeaderKinds>

        <!--__________ Ideology __________-->

        <fixedIdeo>true</fixedIdeo>
        <ideoName>Pack Law</ideoName>
        <ideoDescription>The Jackals don't have a creed so much as an understanding: the pack looks after its own, everyone else is prey or predator, and whoever's strongest today gives the orders until somebody stronger comes along.</ideoDescription>
        <styles>
            <li>FCP_Style_Raider</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Morbid</li>
        </styles>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>
        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>

		<!--__________ Biotech __________-->

		<xenotypeSet>
			<xenotypeChances>
				<Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
				<Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
				<Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
				<Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
				<Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
				<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
				<Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
			</xenotypeChances>
		</xenotypeSet>

        <!--__________ Backstories __________-->

        <backstoryFilters>
            <li>
                <categories>
                    <li>FCP_Backstory_Raiders</li>
                    <li>FCP_Backstory_Raiders_Child</li>
                </categories>
                <commonality>1</commonality>
            </li>
        </backstoryFilters>

        <!--__________ Kinds __________-->

        <caravanTraderKinds>
        </caravanTraderKinds>

        <visitorTraderKinds>
        </visitorTraderKinds>

        <baseTraderKinds>
        </baseTraderKinds>

        <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
        <raidLootMaker>FCP_RaiderRaidLootMaker</raidLootMaker>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,65)</li>
                <li>(70, 85)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <!--__________ Group Makers __________-->

        <pawnGroupMakers>

            <li>
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <FCP_Jackal_Raider>12</FCP_Jackal_Raider>
                    <FCP_Jackal_Gunner>8</FCP_Jackal_Gunner>
                    <FCP_Jackal_Scavenger>6</FCP_Jackal_Scavenger>
                    <FCP_Jackal_Bruiser>5</FCP_Jackal_Bruiser>
                    <FCP_Jackal_Leader>2</FCP_Jackal_Leader>
                    <FCP_Unique_Pawnkind_Jackal_Mange>1</FCP_Unique_Pawnkind_Jackal_Mange>
                    <FCP_Pawnkind_Protectron MayRequire="Rick.FCP.Robotics">1</FCP_Pawnkind_Protectron>
                </options>
            </li>

            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <FCP_Raider_Warlord>1</FCP_Raider_Warlord>
                    <FCP_Jackal_Leader>3</FCP_Jackal_Leader>
                    <FCP_Jackal_Raider>8</FCP_Jackal_Raider>
                </options>
            </li>

            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <FCP_Raider_Warlord>1</FCP_Raider_Warlord>
                    <FCP_Jackal_Leader>2</FCP_Jackal_Leader>
                    <FCP_Jackal_Raider>9</FCP_Jackal_Raider>
                    <FCP_Jackal_Scavenger>7</FCP_Jackal_Scavenger>
                    <FCP_Jackal_Gunner>7</FCP_Jackal_Gunner>
                    <FCP_Jackal_Bruiser>6</FCP_Jackal_Bruiser>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
        <modExtensions Inherit="False">
            <li Class="FCP.Factions.FactionExtension_FlavorOverride">
                <newLabel>Jackals</newLabel>
            </li>
            <li Class="FCP.Factions.FactionExtension_BannedArrivalModes">
                <arrivalModes>
                    <li>EdgeDrop</li>
                    <li>EdgeDropGroups</li>
                    <li>CenterDrop</li>
                    <li>RandomDrop</li>
                </arrivalModes>
            </li>
            <li Class="FCP.Factions.FactionExtension_FixedIdeo">
                <ideoIconDef>FCP_Icon_Raider</ideoIconDef>
                <ideoColorDef>LightGrey</ideoColorDef>
                <memberName>Jackal</memberName>
                <adjective>Jackal</adjective>
                <roleOverrides>
                    <li>
                        <preceptDef>IdeoRole_Leader</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_Moralist</preceptDef>
                        <newName>Representative</newName>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_ShootingSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_MeleeSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_ResearchSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_PlantSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_ProductionSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_MiningSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_AnimalsSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                    <li>
                        <preceptDef>IdeoRole_MedicalSpecialist</preceptDef>
                        <disableApparelRequirements>true</disableApparelRequirements>
                    </li>
                </roleOverrides>
            </li>
            <li Class="FCP.Factions.FactionExtension_HasTerritory">
                <territoryColor>(0.75, 0.75, 0.72, 1.0)</territoryColor>
                <territoryBorderColor>(0.4, 0.4, 0.38, 1.0)</territoryBorderColor>
                <factionLabelColor>(0.9, 0.9, 0.85, 1.0)</factionLabelColor>
                <initialTerritoryRadius>9</initialTerritoryRadius>
                <renderTerritoryOverWater>false</renderTerritoryOverWater>
            </li>
            <li Class="FCP.Factions.FactionExtension_PermanentlyHostileTo">
                <hostileFactionDefs>
                    <li>FCP_Faction_Vipers</li>
                </hostileFactionDefs>
            </li>
        </modExtensions>
    </FactionDef>

    <ThingSetMakerDef>
        <defName>FCP_RaiderRaidLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>Silver</li>
                        <li>MedicineIndustrial</li>
                        <li>ComponentIndustrial</li>
                        <li>MealSurvivalPack</li>
                        <li>Neutroamine</li>
                        <li>Steel</li>
                        <li>Cloth</li>
                        <li>Chemfuel</li>
                        <li MayRequire="Rick.FCP.Chems">FCP_Chem_Jet</li>
                        <li MayRequire="Rick.FCP.Chems">FCP_Chem_Psycho</li>
                        <li MayRequire="Rick.FCP.Chems">FCP_Chem_Buffout</li>
                        <li MayRequire="Rick.FCP.Chems,Rick.FCP.Plants">FCP_Chem_Mentats</li>
                        <li MayRequire="Rick.FCP.Chems">FCP_Chem_Turbo</li>
                        <li MayRequire="Rick.FCP.Chems">FCP_Chem_Stimpak</li>
                        <li MayRequire="Rick.FCP.Chems">FCP_Chem_Super_Stimpak</li>
                        <li MayRequire="Rick.FCP.Chems">FCP_Chem_MedX</li>
                        <li MayRequire="Rick.FCP.Core.Tools">FCP_Currency_Caps</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>

</Defs>
