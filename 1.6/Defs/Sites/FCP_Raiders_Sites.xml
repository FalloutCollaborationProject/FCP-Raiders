<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Site: Turf War -->

    <SitePartDef>
        <defName>FCP_Site_Raider_Turf_War</defName>
        <label>rival gang camp</label>
        <description>A rival gang squatting on Raider turf.</description>
        <workerClass>SitePartWorker_Outpost</workerClass>
        <siteTexture>World/WorldObjects/DefaultSettlement</siteTexture>
        <expandingIconTexture>MapIcons/Sites/FCP_Scrapyard_Site</expandingIconTexture>
        <forceExitAndRemoveMapCountdownDurationDays>6</forceExitAndRemoveMapCountdownDurationDays>
        <requiresFaction>true</requiresFaction>
        <wantsThreatPoints>true</wantsThreatPoints>
        <tags>
            <li>FCP_Site_Raider_Turf_War</li>
        </tags>
    </SitePartDef>

    <GenStepDef>
        <defName>FCP_Site_Raider_Turf_War_Outpost</defName>
        <linkWithSite>FCP_Site_Raider_Turf_War</linkWithSite>
        <order>450</order>
        <genStep Class="GenStep_Outpost"/>
    </GenStepDef>

    <GenStepDef>
        <defName>FCP_Site_Raider_Turf_War_Power</defName>
        <linkWithSite>FCP_Site_Raider_Turf_War</linkWithSite>
        <order>451</order>
        <genStep Class="GenStep_Power"/>
    </GenStepDef>

